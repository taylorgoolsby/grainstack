# Copy to .env.local and fill in. Never commit .env.local.

# --- AWS credentials the portal runs as (it creates IAM users, roles, tables, buckets,
#     stacks and Web Functions). Use an IAM role instead when hosting on AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Make the SDK and the AWS CLI ignore ~/.aws (remove on a server that uses an IAM role):
AWS_SHARED_CREDENTIALS_FILE=/dev/null
AWS_CONFIG_FILE=/dev/null
AWS_EC2_METADATA_DISABLED=true

# --- Portal
USERS_TABLE=grainstack-users
# Signs login cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=
# If set, signup requires this code. Strongly recommended: every signup creates real AWS resources.
SIGNUP_INVITE_CODE=
# How many accounts may be provisioned at the same time
MAX_CONCURRENT_PROVISIONS=2

# --- Offline test mode: in-memory users and fake provisioning, no AWS calls at all.
# Any username starting with "fail" simulates a provisioning failure.
GRAINSTACK_MOCK=0
